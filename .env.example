# ─────────────────────────────────────────────────────────────────────────────
# TERRA — variables d'environnement (exemple)
#
# Copier en `.env` (non versionné). Aucune de ces valeurs n'est exposée au
# navigateur : PAS de préfixe VITE_ sur un secret (brief §4.3 / §14).
# ─────────────────────────────────────────────────────────────────────────────

# Foreca — SERVEUR UNIQUEMENT. Clé générée dans le portail My API.
FORECA_API_KEY=your-foreca-api-key
FORECA_BASE_URL=https://weatherapi.foreca.net

# Mode d'authentification : `bearer` (défaut) ou `query` (?token=).
# À confirmer avec `node scripts/probe-foreca.mjs` (brief §4.1).
# FORECA_AUTH_MODE=bearer

# Ancien flux user/password → token (pfa.foreca.com). NE renseigner que si la
# sonde confirme que le compte fonctionne ainsi. Sinon laisser vide.
# FORECA_USER=
# FORECA_PASS=

# Bascule MSW (dev/test) ↔ API Foreca réelle (validation manuelle seulement).
# Laisser `false` en développement pour économiser le quota (2 000 req/j).
USE_REAL_FORECA_API=false

# ─── Cache & rate-limit distribués (Upstash Redis) ───
# En production : OBLIGATOIRE (partagé entre les instances serverless).
# Sans ces variables → repli mémoire par instance (OK en dev, dégradé en prod).
# Créer une base Redis sur upstash.com (région UE), puis copier l'URL REST + token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Monitoring — non retenu (voir docs/DEPLOIEMENT.md) ───
# SENTRY_DSN=
